{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimi-deck",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "mimi-deck.yhay81.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["43 18 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimi-deck",
      "database_id": "67290c58-e0f8-456c-a0d0-995a1fc946e3",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
